{
  "name": "varanda-monorepo",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "standard",
    "test": "node scripts/run-tests.js --workspaces",
    "demo": "npm run demo -w apps/cli --",
    "eas-build-post-install": "npm run eas-build-post-install -w apps/app"
  },
  "devDependencies": {
    "brittle": "4.5.0",
    "standard": "17.1.2"
  },
  "overrides": {
    "@hyperswarm/dht-relay": {
      "sodium-universal": "5.0.1"
    },
    "hypercore@10.38.2": {
      "sodium-universal": "5.0.1"
    }
  },
  "standard": {
    "ignore": [
      "data/",
      "demo-data/",
      "apps/app/ios/",
      "apps/app/android/",
      "apps/app/dist/",
      "apps/app/.expo/",
      "apps/app/assets/worklet/",
      "apps/app/public/varanda-node.js",
      "**/*.bundle",
      "packages/web-member/dist/"
    ]
  }
}
