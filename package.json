{
  "name": "varanda-monorepo",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "standard",
    "test": "npm test --workspaces --if-present",
    "demo": "npm run demo -w apps/cli --"
  },
  "devDependencies": {
    "brittle": "4.5.0",
    "standard": "17.1.2"
  },
  "standard": {
    "ignore": [
      "data/",
      "demo-data/",
      "apps/app/ios/",
      "apps/app/android/",
      "apps/app/dist/",
      "apps/app/.expo/",
      "apps/app/assets/worklet/",
      "apps/app/public/varanda-node.js",
      "**/*.bundle",
      "packages/web-member/dist/"
    ]
  }
}
