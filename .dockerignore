# Build context of the seeder image (deploy/seeder/Dockerfile): only what the
# CLI needs at run time, plus the LICENSE that ships with it, the deploy
# bundle (/app/deploy/seeder), so a server runs a release without a checkout,
# and the two files update.sh uses to put the media origin into the web app.
# Only these deploy files: never .env, www or anything else under deploy/.
*
!package.json
!package-lock.json
!LICENSE
!packages/core
!packages/rpc
!packages/web-member/package.json
!packages/web-member/lib
!apps/cli
!apps/app/scripts/finish-web.js
!apps/app/scripts/sw.js
!deploy/seeder/compose.yaml
!deploy/seeder/compose.web.yaml
!deploy/seeder/compose.release.yaml
!deploy/seeder/compose.release.web.yaml
!deploy/seeder/Caddyfile
!deploy/seeder/update.sh
!deploy/seeder/update.conf.example
!deploy/seeder/well-known.sh
!deploy/seeder/varanda-update.service
!deploy/seeder/varanda-update.timer
!deploy/seeder/cosign.ref
!deploy/seeder/.env.example
!deploy/seeder/secrets.sealed.json
!deploy/seeder/secrets-signers.txt
**/node_modules
**/test
apps/cli/data
apps/cli/demo-data
