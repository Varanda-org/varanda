# Caddy na frente do semeador: serve o app web (o PWA, em deploy/seeder/www) e
# repassa wss://<domínio>/seeder para a entrada WebSocket do semeador em
# 127.0.0.1, e /account/* para o serviço de conta. TLS automático (Let's
# Encrypt) para o domínio em VARANDA_DOMAIN. Usado por
# deploy/seeder/compose.web.yaml; passo a passo no README, seção "Pôr a versão
# web no ar".
{
	# Sem a API de administração (ela escutaria em 127.0.0.1:2019 do host).
	admin off
	# A ordem do rate_limit (módulo caddy-ratelimit, na imagem de
	# Dockerfile.caddy) é declarada à mão, como o README do módulo pede: dentro
	# de cada handle ele roda antes do reverse_proxy, então um cliente acima do
	# limite leva 429 sem chegar ao semeador.
	order rate_limit before reverse_proxy
	# O módulo registra "rate limit exceeded" com o remote_ip a cada 429 (nível
	# info), e o endereço do cliente não pode ir para registro algum: este é o
	# único log do arquivo, e só EXCLUI esse logger do registro padrão. Não
	# existe registro de acesso (nenhum log dentro do site) e os demais
	# registros do Caddy seguem como estavam.
	log {
		exclude http.handlers.rate_limit
	}
}

{$VARANDA_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		# 'wasm-unsafe-eval' só permite compilar WebAssembly (os hashes do
		# nó no navegador), não eval. connect-src: só a própria origem e o
		# WebSocket do semeador nela.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' wss://{$VARANDA_DOMAIN}; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Cache. Tudo o que sai de /srv/web (index.html, sw.js, varanda-node.js,
	# o manifesto, os ícones e também os nomes com hash em /_expo/ e
	# /assets/) é revalidado pelo ETag a cada carga: no-cache. Sem cache
	# longo (um ano, "imutável") de propósito: o deploy troca os arquivos de
	# www no lugar enquanto o Caddy segue servindo, e um arquivo lido pela
	# metade durante a cópia ganharia um ano de cache que o navegador nunca
	# revalida; com no-cache ele ganha outro ETag quando a cópia termina e
	# se cura na carga seguinte. O service worker já serve os arquivos com
	# hash do seu próprio cache conferido (instala com cache: 'reload'),
	# então um cache HTTP longo renderia pouco. /varanda.json tem o seu
	# próprio no-store, /seeder fica como está, /account/* vem do serviço
	# de conta com o no-store dele, /media/* vem do semeador com o cache
	# longo dele e /index/* vem do semeador com o no-store dele.
	@mutavel {
		not path /varanda.json /seeder /account/* /media/* /index/*
	}
	header @mutavel Cache-Control "no-cache"

	# Um 404 nunca fica guardado em cache (nem pelo navegador, nem pelo
	# service worker): no-store, por cima do no-cache acima. Com extensão, o
	# 404 é o arquivo que falta; sem extensão, só se falta o index.html (por
	# exemplo, enquanto o deploy troca o www).
	@ausenteArquivo {
		path *.*
		not path /varanda.json
		not file {
			root /srv/web
		}
	}
	@ausenteApp {
		not path *.*
		not path /seeder /account/* /media/* /index/*
		not file /index.html {
			root /srv/web
		}
	}
	header @ausenteArquivo Cache-Control "no-store"
	header @ausenteApp Cache-Control "no-store"

	# O tipo do manifesto do PWA. A tabela mailcap da imagem alpine já deve
	# dar este tipo; a linha só o fixa. O '>' adia a operação para depois do
	# file_server, para que ela vença o tipo que ele põe.
	header /manifest.webmanifest >Content-Type "application/manifest+json"

	# Um caminho sem ponto é uma rota do app.
	@semExtensao {
		not path *.*
	}

	# A entrada WebSocket do semeador só aceita o Host 127.0.0.1:<porta>
	# (defesa contra DNS rebinding): o proxy reescreve o Host para o do
	# destino. O Origin do navegador (https://<domínio>) segue intacto e o
	# semeador o confere contra VARANDA_WS_ORIGIN. O Noise vai fim a fim:
	# o Caddy só termina o TLS.
	handle /seeder {
		reverse_proxy 127.0.0.1:{$VARANDA_WS_PORT} {
			header_up Host {upstream_hostport}
		}
	}

	# Configuração pública do app: a chave pública da associação, de
	# VARANDA_ASSOCIATION (deploy/seeder/.env), lida quando o Caddy carrega
	# este arquivo. Mesma origem: o connect-src 'self' acima permite o fetch.
	# O endereço do semeador não vai aqui: a página usa wss://<seu host>/seeder.
	# Antes do handle abaixo: sem este, /varanda.json cairia no index.html.
	handle /varanda.json {
		header Content-Type "application/json"
		header Cache-Control "no-store"
		respond `{"v":1,"association":"{$VARANDA_ASSOCIATION}"}` 200
	}

	# O serviço de conta (vínculo com o Google e @nome), em 127.0.0.1. Como o
	# semeador, ele só aceita o Host do destino. Os cabeçalhos com o endereço
	# do cliente saem: nenhum endereço chega ao serviço. Toda resposta de
	# /account vem dele com Cache-Control no-store (por isso /account/* fica
	# fora do no-cache de @mutavel e do no-store de @ausenteApp acima: nada
	# do cache do app vale para ele). O CSP acima não muda: a página usa
	# fetch na mesma origem e navega (página inteira) para o Google;
	# form-action 'none' só vale para envio de formulários. O service worker
	# também deixa /account/* passar direto para a rede (apps/app/scripts/sw.js).
	# Antes do handle abaixo: sem este, /account/* cairia no index.html.
	handle /account/* {
		reverse_proxy 127.0.0.1:{$VARANDA_ACCOUNT_PORT} {
			header_up Host {upstream_hostport}
			header_up -X-Forwarded-For
			header_up -X-Real-Ip
		}
	}

	# As mídias das publicações (blocos de um núcleo de mídia, endereçados
	# por conteúdo): GET|HEAD /media/<diário>/<núcleo>/<início>/<blocos>,
	# servido pelo semeador na porta do WebSocket, em 127.0.0.1. Como o
	# /seeder, ele só aceita o Host do destino, e os cabeçalhos com o endereço
	# do cliente saem. O Cache-Control (longo) e o 404 vêm do próprio
	# semeador: por isso /media/* fica fora do no-cache de @mutavel e do
	# no-store de @ausenteApp acima, e este arquivo não repete esse valor.
	# O CSP não muda (img-src já permite blob:). O service worker também
	# deixa /media/* passar direto para a rede (apps/app/scripts/sw.js).
	# Antes do handle abaixo: sem este, /media/* cairia no index.html.
	# Limite por cliente (módulo caddy-ratelimit, Dockerfile.caddy): 120
	# requisições a cada 10 s por endereço. As fotos de um diário carregam em
	# rajada (vários blocos por foto, várias fotos por tela), então o teto é
	# folgado; passou dele, 429 com Retry-After (o módulo o calcula). O
	# semeador só tem um limite GLOBAL, que um único cliente esgotaria para
	# todos (503). O endereço do cliente ({remote_host}) existe só na memória do
	# Caddy, durante a janela de 10 s: não vai para registro algum (este
	# arquivo não tem a diretiva log, e o módulo só registra a chave com
	# log_key, que fica desligado) nem para o semeador (os cabeçalhos abaixo o
	# tiram).
	handle /media/* {
		rate_limit {
			zone media {
				key {remote_host}
				events 120
				window 10s
			}
		}
		reverse_proxy 127.0.0.1:{$VARANDA_WS_PORT} {
			header_up Host {upstream_hostport}
			header_up -X-Forwarded-For
			header_up -X-Real-Ip
		}
	}

	# O índice de engajamento do semeador (respostas, citações, curtidas,
	# republicações e as publicações de cada membro, só como referências e
	# contagens: o conteúdo o app busca e confere no próprio diário):
	# GET|HEAD /index/post/..., /index/counts/... e /index/member/...,
	# servido pelo semeador na porta do WebSocket, em 127.0.0.1, como o
	# /media/*. Só aceita o Host do destino, e os cabeçalhos com o endereço do
	# cliente saem. O Cache-Control (no-store) e o 404 vêm do próprio
	# semeador: por isso /index/* fica fora do no-cache de @mutavel e do
	# no-store de @ausenteApp acima. O CSP não muda (fetch na mesma origem).
	# O service worker também deixa /index/* passar direto para a rede
	# (apps/app/scripts/sw.js). Antes do handle abaixo: sem este, /index/*
	# cairia no index.html.
	# Limite por cliente (módulo caddy-ratelimit, Dockerfile.caddy): 20
	# requisições a cada 10 s por endereço. O app consulta o índice por
	# publicação visível (contagens e respostas), então o uso normal é de
	# poucas consultas por tela; o teto é mais apertado que o de /media/*
	# porque cada consulta custa mais ao semeador. Passou dele, 429 com
	# Retry-After. Mesmo cuidado com o endereço: só na memória do Caddy,
	# durante a janela, nunca em registro nem enviado ao semeador.
	handle /index/* {
		rate_limit {
			zone index {
				key {remote_host}
				events 20
				window 10s
			}
		}
		reverse_proxy 127.0.0.1:{$VARANDA_WS_PORT} {
			header_up Host {upstream_hostport}
			header_up -X-Forwarded-For
			header_up -X-Real-Ip
		}
	}

	# O app é uma página única: um caminho sem extensão é o app (index.html).
	# Um caminho COM extensão é servido como arquivo ou é um 404 de verdade,
	# nunca o index.html (que, com nosniff, viraria uma página em branco).
	handle {
		root * /srv/web
		rewrite @semExtensao /index.html
		file_server
	}
}
