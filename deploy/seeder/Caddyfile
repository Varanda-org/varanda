# Caddy na frente do semeador: serve o app web (o PWA, em deploy/seeder/www) e
# repassa wss://<domínio>/seeder para a entrada WebSocket do semeador em
# 127.0.0.1, e /account/* para o serviço de conta. TLS automático (Let's
# Encrypt) para o domínio em VARANDA_DOMAIN. Usado por
# deploy/seeder/compose.web.yaml; passo a passo no README, seção "Pôr a versão
# web no ar".
{
	# Sem a API de administração (ela escutaria em 127.0.0.1:2019 do host).
	admin off
}

{$VARANDA_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		# 'wasm-unsafe-eval' só permite compilar WebAssembly (os hashes do
		# nó no navegador), não eval. connect-src: só a própria origem e o
		# WebSocket do semeador nela.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' wss://{$VARANDA_DOMAIN}; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# A entrada WebSocket do semeador só aceita o Host 127.0.0.1:<porta>
	# (defesa contra DNS rebinding): o proxy reescreve o Host para o do
	# destino. O Origin do navegador (https://<domínio>) segue intacto e o
	# semeador o confere contra VARANDA_WS_ORIGIN. O Noise vai fim a fim:
	# o Caddy só termina o TLS.
	handle /seeder {
		reverse_proxy 127.0.0.1:{$VARANDA_WS_PORT} {
			header_up Host {upstream_hostport}
		}
	}

	# Configuração pública do app: a chave pública da associação, de
	# VARANDA_ASSOCIATION (deploy/seeder/.env), lida quando o Caddy carrega
	# este arquivo. Mesma origem: o connect-src 'self' acima permite o fetch.
	# O endereço do semeador não vai aqui: a página usa wss://<seu host>/seeder.
	# Antes do handle abaixo: sem este, /varanda.json cairia no index.html.
	handle /varanda.json {
		header Content-Type "application/json"
		header Cache-Control "no-store"
		respond `{"v":1,"association":"{$VARANDA_ASSOCIATION}"}` 200
	}

	# O serviço de conta (vínculo com o Google e @nome), em 127.0.0.1. Como o
	# semeador, ele só aceita o Host do destino. Os cabeçalhos com o endereço
	# do cliente saem: nenhum endereço chega ao serviço. Toda resposta de
	# /account vem dele com Cache-Control no-store. O CSP acima não muda: a
	# página usa fetch na mesma origem e navega (página inteira) para o
	# Google; form-action 'none' só vale para envio de formulários.
	# Antes do handle abaixo: sem este, /account/* cairia no index.html.
	handle /account/* {
		reverse_proxy 127.0.0.1:{$VARANDA_ACCOUNT_PORT} {
			header_up Host {upstream_hostport}
			header_up -X-Forwarded-For
			header_up -X-Real-Ip
		}
	}

	# O app é uma página única: um caminho que não é arquivo volta para
	# index.html.
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
