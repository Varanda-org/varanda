# Copie para deploy/seeder/.env (fora do git) e preencha. Lido pelo Docker
# Compose ao subir compose.web.yaml.

# Domínio público da versão web, sem https:// e sem barra (o DNS dele precisa
# apontar para este servidor antes de subir: o Caddy pede o certificado TLS).
VARANDA_DOMAIN=app.exemplo.org

# Chave pública da associação (64 dígitos hexadecimais), servida
# pelo Caddy em https://<domínio>/varanda.json para o app web. É um dado
# público, mas precisa ser a associação em que o semeador confia (a que
# `seed status` mostra). Vazia, o compose não sobe; vazia ou fora desse
# formato, o deploy.sh recusa implantar.
VARANDA_ASSOCIATION=

# Cliente OAuth do Google (tipo "Aplicativo da Web") do serviço de conta, que
# liga o membro a uma conta Google. URI de redirecionamento autorizado:
# https://<domínio>/account/callback. Escopos: openid email. Vazios, o
# compose não sobe e o deploy.sh recusa implantar.
VARANDA_GOOGLE_CLIENT_ID=
# Segredo do cliente: nunca no git (este .env fica fora dele) e nunca
# impresso em registro ou saída; o deploy.sh só confere que não está vazio.
VARANDA_GOOGLE_CLIENT_SECRET=

# E-mails Google dos moderadores, separados por vírgula, em minúsculas e
# exatamente como o Google os mostra. Só eles entram no painel de moderação em
# https://<domínio>/account/mod/. Vazio desliga o painel (o vínculo e as
# denúncias continuam funcionando). Não é segredo, mas este .env fica fora do
# git. Registre também o segundo URI de redirecionamento autorizado no cliente
# OAuth: https://<domínio>/account/mod/callback. Mudar a lista exige recriar o
# contêiner account (docker compose ... up -d --force-recreate account).
VARANDA_MODERATOR_EMAILS=

# E-mails que veem a aba Estatísticas do painel de moderação (só contagens
# anônimas de uso). Um subconjunto dos moderadores acima, separados por
# vírgula, em minúsculas, no máximo 32. Vazio desliga a aba, a amostragem e o
# usage.json. Nunca impresso. Mudar a lista exige recriar o contêiner account
# (docker compose ... up -d --force-recreate account). O serviço lê a saúde do
# semeador em VARANDA_SEEDER_HEALTH, cujo padrão no compose é
# http://127.0.0.1:8788; se definir, mantenha no loopback.
VARANDA_STATS_EMAILS=

# Triagem das denúncias por IA (similaridade semântica com o modelo MiniLM,
# rodando no próprio servidor; o humano decide só quando a IA está em dúvida).
# Vazio desliga (padrão). 'sombra' só registra as sugestões no painel, sem
# decidir nada. '1' deixa a IA decidir (os bloqueios continuam pendentes até o
# `mod apply` do operador). Comece em 'sombra'. Mudar exige recriar os
# contêineres (docker compose ... up -d --force-recreate seeder account).
VARANDA_AI=
# Segredo que o serviço account usa para ler no semeador o post e a mensagem
# de grupo denunciados (só em 127.0.0.1). 64 dígitos hexadecimais aleatórios,
# gerados com `openssl rand -hex 32`; o mesmo valor vale para os dois serviços
# (este .env alimenta ambos). Nunca no git e nunca impresso. Vale mesmo com a
# triagem por IA desligada: vazio desliga as leituras, e então os dois
# bloqueios de uma denúncia de grupo ficam recusados no painel. Um token
# inválido impede o serviço account de subir (erro de uso; o contêiner fica
# reiniciando).
#
# Os pesos do modelo ficam em /data/ai-model, dentro do volume account-data
# (caminho fixo: não há variável para isso aqui), e nada é baixado em tempo de
# execução. Baixe-os uma vez, da raiz do repositório, com a própria imagem:
#   docker compose -f deploy/seeder/compose.yaml -f deploy/seeder/compose.web.yaml run --rm --entrypoint node account apps/cli/scripts/fetch-ai-model.js --dir /data/ai-model
VARANDA_TRIAGE_TOKEN=

# Avisos push no navegador (novo seguidor, resposta, curtida, repostagem),
# opcionais. Segredo que o semeador usa para repassar os avisos ao serviço
# account (só em 127.0.0.1). 64 dígitos hexadecimais em minúsculas, gerados com
# `openssl rand -hex 32`; o mesmo valor vale para os dois serviços (este .env
# alimenta ambos). Nunca no git e nunca impresso. Vazio desliga os avisos. A
# chave VAPID não passa por aqui: fica em push-vapid.json, no volume
# account-data. Mudar exige recriar os contêineres (docker compose ... up -d
# --force-recreate seeder account). Veja "Avisos push" no README.
VARANDA_PUSH_TOKEN=

# Limites opcionais do serviço de conta. Deixe comentado para usar os padrões;
# um valor precisa ser um inteiro positivo. Mudar exige recriar o contêiner
# account (docker compose ... up -d --force-recreate account).
# Teto de membros vinculados (padrão: sem teto). Passando dele, um vínculo
# NOVO recebe a resposta "lista de espera" e quem já é membro não muda. O
# semeador tem o próprio limite de 4096 diários: mantenha este valor igual ou
# abaixo dele.
#VARANDA_MAX_MEMBERS=
# Convites por semana para cada membro (1 a 100; vazio = cadastro aberto).
# Ligado, só entra quem tem convite; cada link vale 7 dias e a cota renova na
# segunda, no horário de Brasília. Com a rede vazia ninguém entra: vincule a
# primeira pessoa com esta variável vazia e só depois a ligue.
#VARANDA_INVITES_PER_WEEK=
# Verificação de idade (Didit): chave da API e id do workflow. Os dois vazios
# deixam desligada; os dois definidos ligam para todo membro hospedado.
#VARANDA_DIDIT_API_KEY=
#VARANDA_DIDIT_WORKFLOW_ID=
# Teto diário de sessões no Didit (padrão: 200).
#VARANDA_DIDIT_DAILY_LIMIT=
# Conta de pagamentos (Hodle), opcional. Chave vazia deixa desligada. O
# prefixo hodle_live_ ou hodle_test_ escolhe produção ou sandbox.
#VARANDA_HODLE_API_KEY=
# Rede da carteira: polygon (padrão) ou base. Fixa por membro na primeira carteira.
#VARANDA_HODLE_NETWORK=polygon
# Modo: cadastro (padrão), carteira ou pix; completo virá numa versão futura.
#VARANDA_HODLE_MODE=cadastro
# Teto diário de subcontas, verificações e operações (padrão: 100).
#VARANDA_HODLE_DAILY_LIMIT=100
# Teto por operação em centavos, taxas incluídas (padrão: 300000; de 100 a 100000000).
#VARANDA_HODLE_MAX_CENTS=300000
# Webhooks do Hodle, opcional: lista EVENTO:hex64 (ou EVENTO:registrar para o
# primeiro cadastro), um por webhook. Vazia, a rota responde 404.
#VARANDA_HODLE_WEBHOOK_SECRETS=
# Taxa da Varanda por tipo, em centavos fixos e em pontos-base (padrão: 0).
# DEPOSIT deve ficar em 0 nesta versão. SWAP deve ficar em 0: a troca de
# moeda não tem taxa da Varanda, e outro valor recusa a partida. A taxa de
# PAYOUT só é cobrada depois que o Pix é concluído, em geral no próximo envio.
#VARANDA_FEE_TRANSFER_CENTS=0
#VARANDA_FEE_TRANSFER_BPS=0
#VARANDA_FEE_PAYOUT_CENTS=0
#VARANDA_FEE_PAYOUT_BPS=0
#VARANDA_FEE_CRYPTO_CENTS=0
#VARANDA_FEE_CRYPTO_BPS=0
#VARANDA_FEE_DEPOSIT_CENTS=0
#VARANDA_FEE_DEPOSIT_BPS=0
#VARANDA_FEE_SWAP_BPS=0
# Tesouraria que recebe a taxa: sub:<subAccountId> ou endereço 0x na rede
# configurada. Obrigatória com qualquer taxa.
#VARANDA_FEE_TREASURY=
# Conexões simultâneas (padrão: 64).
#VARANDA_ACCOUNT_MAX_CONNECTIONS=64
# Requisições por segundo (padrão: 20).
#VARANDA_ACCOUNT_RATE=20
# Rajada permitida acima da taxa (padrão: 100).
#VARANDA_ACCOUNT_BURST=100
# Vínculos pendentes ao mesmo tempo (padrão: 1000).
#VARANDA_ACCOUNT_MAX_PENDING=1000

# Limites do semeador web (todos opcionais; comentados ou vazios usam o padrão
# do semeador). Os valores vêm de apps/cli/scripts/load-ws.js e de
# docs/verification.md. Inteiros positivos; suba VARANDA_FRAME_MEMORY junto
# com VARANDA_MAX_EXTERNAL. O deploy.sh recusa um valor que não seja inteiro.
# Conexões externas (navegadores) simultâneas aceitas.
# VARANDA_MAX_EXTERNAL=
# Sockets abertos no total (conexões externas e internas).
# VARANDA_MAX_SOCKETS=
# Memória, em bytes, reservada para quadros em trânsito (de 8454144, o maior
# quadro válido, a 1073741824).
# VARANDA_FRAME_MEMORY=
# Downloads de mídia simultâneos.
# VARANDA_MEDIA_MAX_IN_FLIGHT=
# Pedidos de mídia por segundo (ritmo sustentado).
# VARANDA_MEDIA_RATE=
# Pedidos de mídia aceitos em rajada.
# VARANDA_MEDIA_BURST=
# Consultas de índice simultâneas.
# VARANDA_INDEX_MAX_IN_FLIGHT=
# Consultas de índice por segundo (ritmo sustentado).
# VARANDA_INDEX_RATE=
# Consultas de índice aceitas em rajada.
# VARANDA_INDEX_BURST=

# Login nativo com passkey (opcional; vazio desliga o login nativo naquela
# plataforma, com um aviso no deploy). O deploy.sh grava em www os arquivos
# /.well-known/assetlinks.json (Android) e /.well-known/apple-app-site-association
# (iOS), que dizem ao sistema qual app pode usar as passkeys deste domínio, e
# recusa a implantação se um valor preenchido tiver outra forma.
# Android: o SHA-256 do certificado de assinatura de RELEASE (o que aparece em
# `eas credentials -p android`), em hexadecimal maiúsculo separado por
# dois-pontos (AA:BB:...). Instalações de depuração são app.varanda.debug e
# não casam com este arquivo.
VARANDA_ANDROID_CERT_SHA256=
# iOS: o Team ID da Apple seguido do bundle id, na forma TEAMID.app.varanda.
VARANDA_IOS_APP_ID=
