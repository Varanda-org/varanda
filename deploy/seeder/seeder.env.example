# /etc/varanda/seeder.env: variáveis lidas por varanda-seeder.service.
# Arquivo opcional; tire o # das linhas que usar.

# Associação em que o semeador confia. Obrigatória só até o primeiro comando
# gravar config.json; depois, se presente, precisa ser a mesma.
#VARANDA_ASSOCIATION=<64 hex>

# DHT privada (host:porta, separados por vírgula). Sem esta linha o semeador
# usa a DHT pública; uma linha vazia é erro de uso.
#VARANDA_BOOTSTRAP=host:porta

# Endpoint de saúde e métricas. Endereço padrão 127.0.0.1: só esta máquina.
#VARANDA_HEALTH_PORT=8788
#VARANDA_HEALTH_HOST=127.0.0.1

# Segredo da rota local de triagem por IA (64 hex, `openssl rand -hex 32`), o
# mesmo do serviço de conta. Sem esta linha a rota fica desligada.
#VARANDA_TRIAGE_TOKEN=<64 hex>

# Segredo dos avisos push (64 hex, `openssl rand -hex 32`), o mesmo do serviço
# de conta. Sem esta linha os avisos ficam desligados.
#VARANDA_PUSH_TOKEN=<64 hex>
# Onde o serviço de conta escuta (só loopback). Padrão http://127.0.0.1:8790.
#VARANDA_ACCOUNT_HTTP=http://127.0.0.1:8790

# A Feira (anúncios públicos). Exemplos para quem usa o deploy/seeder/.env do
# compose.web.yaml; deixe as duas comentadas para a Feira ficar desligada.
# Origem https das páginas públicas /f/* (minúsculas, sem caminho). Vazia, as
# rotas respondem 404. Ligue só depois que o app e os Termos da Feira estiverem
# no ar.
#VARANDA_FEIRA_ORIGIN=https://varanda.example
# Cadastros por semana de cada dono pelo link de um anúncio, de 1 a 100 (10 é
# só um exemplo do operador). Exige VARANDA_INVITES_PER_WEEK e
# VARANDA_TRIAGE_TOKEN.
#VARANDA_FEIRA_INVITES_PER_WEEK=10

# As páginas públicas de publicação (/p/<diário>/<seq>, um aperitivo para quem
# está fora da Varanda), independentes da Feira: uma origem não liga a outra.
# Origem https (minúsculas, sem caminho), no deploy/seeder/.env do
# compose.web.yaml ou aqui. Desligadas por padrão: sem esta linha cada página
# redireciona para o app (/publicacao/...) e /p/policy diz que estão
# desligadas. Ligue só depois que os Termos da instalação estiverem na
# versão 48 e o operador tiver decidido quem pode publicar.
#VARANDA_POSTS_ORIGIN=https://varanda.example
