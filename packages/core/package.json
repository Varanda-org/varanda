{
  "name": "@varanda/core",
  "version": "0.1.0",
  "private": true,
  "description": "Núcleo do protocolo Varanda: registros, certificados, armazenamento, rede e sincronização",
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=20"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./lib/*": "./lib/*.js",
    "./package.json": "./package.json"
  },
  "imports": {
    "#fs": {
      "bare": "./lib/bare/fs.js",
      "browser": "./lib/browser/fs.js",
      "default": "./lib/node/fs.js"
    },
    "#path": {
      "bare": "./lib/bare/path.js",
      "browser": "./lib/browser/path.js",
      "default": "./lib/node/path.js"
    },
    "#process": {
      "bare": "./lib/bare/process.js",
      "browser": "./lib/browser/process.js",
      "default": "./lib/node/process.js"
    }
  },
  "scripts": {
    "test": "node ../../scripts/run-tests.js"
  },
  "dependencies": {
    "@hyperswarm/secret-stream": "6.9.2",
    "@varanda/rpc": "0.1.0",
    "b4a": "1.9.0",
    "bare-fs": "4.8.4",
    "bare-path": "3.1.2",
    "bare-process": "4.5.1",
    "compact-encoding": "3.5.2",
    "corestore": "7.15.0",
    "hypercore": "11.39.0",
    "hypercore-crypto": "3.7.0",
    "hyperdht": "6.34.1",
    "hyperswarm": "4.17.2",
    "streamx": "2.28.1"
  },
  "devDependencies": {
    "bare-runtime": "1.33.4"
  }
}
