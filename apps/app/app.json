      "resizeMode": "contain",
      "backgroundColor": "#fbf8f3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.varanda",
      "associatedDomains": [
        "webcredentials:bora.varanda.app",
