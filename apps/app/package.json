{
  "name": "@varanda/app",
  "version": "0.1.0",
  "private": true,
  "description": "Varanda: aplicativo iOS, Android e web",
  "license": "PolyForm-Noncommercial-1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "bash scripts/link-addons.sh check android && expo run:android",
    "ios": "bash scripts/link-addons.sh check ios && expo run:ios",
    "build:node": "node ../../packages/web-member/scripts/build.js --node public/varanda-node.js",
    "web": "npm run build:node && expo start --web",
    "export:web": "npm run build:node && expo export --platform web && node scripts/finish-web.js",
    "prepare:native": "bash scripts/prepare-native.sh",
    "eas-build-post-install": "bash scripts/eas-post-install.sh",
    "link:addons": "bash scripts/link-addons.sh",
    "pack:worklet": "bash scripts/pack-worklet.sh",
    "gate": "node scripts/gate-server.js",
    "test": "node ../../scripts/run-tests.js"
  },
  "dependencies": {
    "@expo/metro-runtime": "55.0.12",
    "@expo/vector-icons": "15.1.1",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@react-native-community/netinfo": "11.5.2",
    "@varanda/core": "0.1.0",
    "@varanda/rpc": "0.1.0",
    "@varanda/web-member": "0.1.0",
    "bare-crypto": "1.15.4",
    "bare-encoding": "1.0.3",
    "bare-http1": "4.6.2",
    "bare-https": "3.1.0",
    "bare-ws": "3.2.0",
    "expo": "55.0.31",
    "expo-audio": "55.0.18",
    "expo-background-task": "55.0.22",
    "expo-build-properties": "55.0.18",
    "expo-clipboard": "55.0.17",
    "expo-crypto": "55.0.19",
    "expo-file-system": "55.0.26",
    "expo-haptics": "55.0.18",
    "expo-image-manipulator": "55.0.21",
    "expo-image-picker": "55.0.24",
    "expo-secure-store": "55.0.18",
    "expo-status-bar": "55.0.6",
    "expo-task-manager": "55.0.20",
    "expo-video": "55.0.21",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-bare-kit": "0.16.0",
    "react-native-safe-area-context": "5.6.2",
    "react-native-web": "0.21.3"
  },
  "devDependencies": {
    "bare-link": "4.0.1",
    "bare-pack": "2.2.4",
    "brittle": "4.5.0"
  }
}
