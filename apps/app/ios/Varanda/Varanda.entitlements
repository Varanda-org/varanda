<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- webcredentials ties the app to the installation host: iOS offers its
     passkeys (rp.id bora.varanda.app) to the passkey-prf module and hands the
     https return of the auth-session module to this app only. It works once
     https://bora.varanda.app/.well-known/apple-app-site-association lists
     <TeamID>.app.varanda (VARANDA_IOS_APP_ID in deploy/seeder/.env) and the
     provisioning profile carries Associated Domains. applinks opens only /anuncio/ in the app (the AASA components list it). Info.plist
     VarandaWebCredentials says the build has this entry; app.json
     ios.associatedDomains repeats it for prebuild. -->
<plist version="1.0">
  <dict>
    <key>com.apple.developer.associated-domains</key>
    <array>
      <string>webcredentials:bora.varanda.app</string>
      <string>applinks:bora.varanda.app</string>
    </array>
  </dict>
</plist>
