{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "node": "24.22.1",
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview-simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "node": "24.22.1",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "npm_config_ignore_scripts": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6831662804"
      }
    }
  }
}
